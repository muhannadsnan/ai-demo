# ---------------------------------------------------------------------------
# Copy this file to `.env` and restart `npm run dev` after changing it.
# `.env` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Which AI backend to use: mock | openai | ollama
#   mock   = no key, no network, works offline. Default so the demo always runs.
#   openai = the real thing. Needs NUXT_OPENAI_API_KEY below.
#   ollama = free local models. Install from https://ollama.com, then:
#              ollama pull llama3.2 && ollama pull nomic-embed-text
NUXT_AI_PROVIDER=mock

# --- OpenAI -----------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys (or ask your company for
# one on the company org). It looks like: sk-proj-...
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_CHAT_MODEL=gpt-4o-mini
NUXT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# If your company uses Azure OpenAI or a gateway, point this at it instead:
NUXT_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (local, free, no key) -------------------------------------------
NUXT_OLLAMA_BASE_URL=http://localhost:11434
NUXT_OLLAMA_CHAT_MODEL=llama3.2
NUXT_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
