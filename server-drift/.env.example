# Copy to server-drift/.env on the server. Never commit the real file.
#
#   cp .env.example .env && chmod 600 .env

# --- Required -----------------------------------------------------------------
# The domain must already have an A record pointing at this server BEFORE the
# first `docker compose up`, or Caddy's certificate request will fail.
DOMAIN=demo.example.no
TLS_EMAIL=you@example.no

# --- Application --------------------------------------------------------------
NUXT_AI_PROVIDER=mock
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_CHAT_MODEL=gpt-4o-mini
NUXT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Deploy -------------------------------------------------------------------
# Tag the image with the git SHA so you can tell what is running, and roll back
# to a specific build rather than "the previous one, probably".
APP_VERSION=local
