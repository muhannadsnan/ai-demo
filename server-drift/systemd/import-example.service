# Copy to /etc/systemd/system/ and rename per job, e.g. import-enheter.service
# See ../SCHEDULING.md for why the schedule lives on the host, not in a container.

[Unit]
Description=Import job (example)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/app/server-drift
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.data.yml run --rm ingest import enheter

# Do not let a hung import run into the next day.
TimeoutStartSec=3600
