# Copy to /etc/systemd/system/ alongside the matching .service, then:
#   sudo systemctl enable --now import-example.timer

[Unit]
Description=Run the example import nightly

[Timer]
OnCalendar=*-*-* 01:15:00

# If the server was down at 01:15, run the job at next boot instead of
# skipping the day silently.
Persistent=true

# Stop every job on the box firing at exactly the same second.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
