# Monthly full company reconciliation
[Unit]
Description=Monthly full company reconciliation

[Timer]
Unit=nordata@enheter.service
# Brreg genererer fila rundt 04:24. Kjører etter, men If-Modified-Since
# gjør timingen ufarlig uansett: treffer vi feil, henter neste kjøring den nye.
OnCalendar=*-*-01 06:00:00

# If the machine was off when this was due, run it at next boot instead of
# skipping the day silently.
Persistent=true

# Stop every job on the box firing at the same instant.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
