# Daily incremental company update
[Unit]
Description=Daily incremental company update

[Timer]
Unit=nordata@oppdateringer.service
# endringsstrømmen først — alt annet leser det den skriver
OnCalendar=*-*-* 04:00:00

# If the machine was off when this was due, run it at next boot instead of
# skipping the day silently.
Persistent=true

# Stop every job on the box firing at the same instant.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
