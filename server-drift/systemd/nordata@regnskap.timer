# Daily accounts fetch for companies that have filed something new
[Unit]
Description=Daily accounts fetch for newly filed annual accounts

[Timer]
Unit=nordata@regnskap.service
# 04:15, after the change feed at 04:00 has refreshed
# enheter.siste_innsendte_aarsregnskap — which is the signal this job reads.
# Running it before would ask yesterday's question.
OnCalendar=*-*-* 04:15:00

# If the machine was off when this was due, run it at next boot instead of
# skipping the day silently.
Persistent=true

# Stop every job on the box firing at the same instant.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
