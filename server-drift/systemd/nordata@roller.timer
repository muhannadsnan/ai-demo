# Weekly roles reload
[Unit]
Description=Weekly roles reload

[Timer]
Unit=nordata@roller.service
OnCalendar=Sun *-*-* 03:00:00

# If the machine was off when this was due, run it at next boot instead of
# skipping the day silently.
Persistent=true

# Stop every job on the box firing at the same instant.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
